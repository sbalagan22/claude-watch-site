# claude_watch — site environment
#
# Everything is optional. With nothing set the site builds and deploys, and
# the download button points at the latest GitHub release.

# --- Site --------------------------------------------------------------------
# Canonical origin, used for OG tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://claudewatch.app

# Direct HTTPS link to the current .dmg. Defaults to the latest GitHub
# release (github.com/sbalagan22/claude-watch/releases/latest) if unset.
NEXT_PUBLIC_DOWNLOAD_URL=

# --- Analytics ---------------------------------------------------------------
# Plausible domain. Cookie-free, so no banner. Unset loads nothing.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
